<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>YSWinUI3</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultXamlItems>true</EnableDefaultXamlItems>
    <PackageId>YSWinUI3</PackageId>
    <Version>0.1.0</Version>
    <Authors>YSWinUI3</Authors>
    <Description>Reusable WinUI 3 window infrastructure with custom title bars, DWM backdrops, theme synchronization, navigation, and settings persistence.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="YSWinUI3.Demo\**" />
    <EmbeddedResource Remove="YSWinUI3.Demo\**" />
    <None Remove="YSWinUI3.Demo\**" />
    <Content Remove="YSWinUI3.Demo\**" />
    <Resource Remove="YSWinUI3.Demo\**" />
    <PRIResource Remove="YSWinUI3.Demo\**" />
    <Page Remove="YSWinUI3.Demo\**" />
    <ApplicationDefinition Remove="YSWinUI3.Demo\**" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1721" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
